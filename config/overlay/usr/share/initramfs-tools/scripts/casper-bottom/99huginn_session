#!/bin/sh
# Live session: casper's autologin setup picks the Plasma session for SDDM. Point it at Huginn instead.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac
f=/root/etc/sddm.conf
if [ -f "$f" ] && grep -q '^Session=' "$f"; then
    sed -i 's/^Session=.*/Session=huginn/' "$f"
    # If the session ends (signed out, or it fell over), go straight back in. Without this the sign-in screen came up
    # asking for a password, and the trial account hasn't got one to give.
    if grep -q '^Relogin=' "$f"; then
        sed -i 's/^Relogin=.*/Relogin=true/' "$f"
    else
        sed -i '/^Session=huginn/a Relogin=true' "$f"
    fi
fi
exit 0
