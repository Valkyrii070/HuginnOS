#!/bin/sh
# Huginn OS: dress the sign-in screen in a realm (Settings › Appearance › "Use on the sign-in screen").
# Runs as root through pkexec (org.huginn.login-look); takes one realm name and writes it for the sign-in screen.
set -eu
case "${1:-}" in
    aurora|bifrost|muspelheim|niflheim) ;;
    *) echo "huginn-login-look: not a realm: ${1:-}" >&2; exit 2 ;;
esac
dir=/etc/huginn/signin.conf.d
mkdir -p "$dir"
tmp=$(mktemp "$dir/.look.XXXXXX")
printf '[Look]\n# Set by Settings › Appearance.\nRealm=%s\n' "$1" > "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$dir/10-look.conf"
