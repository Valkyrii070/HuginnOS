#!/bin/sh
# Huginn's sign-in service failed three times in a minute. So that nobody is left at a black screen: the sign-in
# screen this system had before (SDDM, when it is still installed), else a text sign-in on the first screen.
logger -t huginn-signin "the sign-in screen couldn't start; falling back" 2>/dev/null || true
plymouth quit 2>/dev/null || true
: > /run/huginn-signin.failed                      # (what lets SDDM start: sddm.service.d/huginn-signin.conf)
if [ -x /usr/bin/sddm ] && systemctl cat sddm.service >/dev/null 2>&1; then
    exec systemctl --no-block start sddm.service
fi
exec systemctl --no-block start getty@tty1.service
