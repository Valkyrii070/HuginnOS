#!/bin/sh
# The installation drive signs you in by itself: casper-bottom/99huginn_session writes who (the trial account) for
# Huginn's sign-in service. If that didn't happen (an older initramfs), it's written here, before the service starts.
conf=/etc/huginn/signin.conf.d/05-live.conf
[ -f "$conf" ] && exit 0
user=$(sed -n 's/^export USERNAME="\(.*\)"$/\1/p' /etc/casper.conf 2>/dev/null | head -n 1)
[ -n "$user" ] && getent passwd "$user" >/dev/null || exit 0
mkdir -p /etc/huginn/signin.conf.d
printf '[Autologin]\n# The installation drive (huginn-live-session).\nUser=%s\nSession=huginn\nRelogin=true\n' "$user" > "$conf"
