// The live system only (the installer deletes this file from the system it installs): the live user may run the
// installer's engine, and anything else the system would ask a password for (adding a language in Code, putting in
// an app), without one. The live session's account has no password to type, so a prompt there could never be answered.
polkit.addRule(function (action, subject) {
    if (subject.user === "huginn" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
