[Unit]
Description=Huginn sign-in
Documentation=file:///usr/share/huginn-apps/huginn_signind.py
Conflicts=getty@tty1.service plymouth-quit-wait.service
After=systemd-user-sessions.service getty@tty1.service plymouth-start.service plymouth-quit-wait.service plymouth-quit.service systemd-logind.service
# an update waiting to go in goes in first; the installation drive says who signs in first
After=huginn-os-update-apply.service huginn-live-session.service
# If it can't run (three failures in a minute), something that can takes the screen: see huginn-signin-fallback.
OnFailure=huginn-signin-fallback.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/libexec/huginn-signind
Restart=on-failure
RestartSec=1s
TimeoutStopSec=25s
EnvironmentFile=-/etc/default/locale

[Install]
Alias=display-manager.service
